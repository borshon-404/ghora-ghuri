# server-stubs/.env  (copy to .env, never commit the real file)

# Port the Node example listens on (put nginx/Caddy in front for TLS)
PORT=8787

# Where the JSON data files live, relative to the stub
DATA_DIR=../data

# Admin credential. ADMIN_HASH is what the server compares against:
#   printf '%s' 'ghora-admin:YourRealPassphrase' | sha256sum
ADMIN_USER=ghora-admin
ADMIN_HASH=
SESSION_SECRET=generate-32-random-bytes

# Origin allowed to call the API (the site's own origin). Empty = '*' for development only.
ALLOW_ORIGIN=https://ghoraghuri.com

# Optional: reCAPTCHA v3 secret; the server rejects score < 0.5 when set
RECAPTCHA_SECRET=

# Optional: email delivery for booking notifications
MAIL_TO=bookings@ghoraghuri.example
